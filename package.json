{
  "name": "stereobit",
  "version": "1.0.0",
  "description": "Private Website",
  "type": "module",
  "repository": "https://github.com/Stereobit/stereobit.git",
  "author": "Tobias Otte <t@stereob.it>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "warn"
    }
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf ./build",
    "format": "prettier --write .",
    "deploy": ". ./.env && : \"${SSH_URL:?SSH_URL is not set in .env}\" && npm run clean && npm run build && rsync -avz --delete --exclude 'logs' --exclude 'usage' build/ \"$SSH_URL\""
  },
  "devDependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "browserslist": "^4.29.4",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}
