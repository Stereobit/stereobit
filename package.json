  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.1",
    "autoprefixer": "^10.5.0",
    "babel-loader": "^10.1.1",
    "compression-webpack-plugin": "^12.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "normalize.css": "^8.0.1",
    "postcss-loader": "^8.2.1",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.6"
  },
  "scripts": {
    "start": "NODE_ENV=development webpack serve --config webpack.development.js",
    "build": "NODE_ENV=production webpack --config webpack.production.js",
    "clean": "rm -rf ./build",
    "deploy": "npm run clean && npm run build && rsync -avz --delete --exclude 'logs' --exclude 'usage' build/ $(grep SSH_URL .env | cut -d '=' -f2)"
  }
